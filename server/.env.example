# TPL2026 Server Environment Variables
# Copy this file to .env and fill in values

# JWT secret for token signing (change in production)
JWT_SECRET=tpl2026-secret-key

# Admin credentials (change in production)
ADMIN_USER=admin
ADMIN_PASS=tpl2026admin

# Server port
PORT=3000

# Frontend URL for CORS (change for production deployment)
FRONTEND_URL=http://localhost:4200

# ============================================================
# GOOGLE DRIVE INTEGRATION (Optional)
# ============================================================
# When all three vars below are set, the app reads/writes
# the Excel file from Google Drive and uploads images to Drive.
# When not set, the app uses local Excel + local /uploads folder.
#
# Setup steps:
#  1. Create a Google Cloud project
#  2. Enable Drive API
#  3. Create a Service Account, download JSON key
#  4. Share the Drive Excel file with the service account email (Editor)
#  5. Share the Drive images folder with the service account email (Editor)
#  6. Set the vars below

# Google Drive Excel file ID
# https://docs.google.com/spreadsheets/d/1Crgw70m9nfN_CaLy-24VUQjHs8cMbw9k/edit
DRIVE_FILE_ID=1Crgw70m9nfN_CaLy-24VUQjHs8cMbw9k

# Google Drive images folder ID
# https://drive.google.com/drive/folders/1c124sGpFDaxVbEiKipJTQ1qePNKljW0y
DRIVE_FOLDER_ID=1c124sGpFDaxVbEiKipJTQ1qePNKljW0y

# Service account JSON key (paste raw JSON or base64-encoded)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SERVICE_ACCOUNT_JSON=
